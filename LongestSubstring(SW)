#Sliding window method
class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:

        seen = set()
        left = 0
        longest = 0

        for right in range(len(s)):

            while s[right] in seen:
                seen.remove(s[left])
                left += 1

            seen.add(s[right])
            longest = max(longest, right - left + 1) #doesn't change

        return longest
#Basically you maintain a sliding window with UNIQUE CHARECTARS only
#Longest is calculated each time a char is added and saved
