class Solution:
    def romanToInt(self, s: str) -> int:
        roman = {"I":1,"V":5,"X":10,"L":50,"C":100,"D":500,"M":1000}
        i, total = len(s)-1, 0
        rev = s[::-1]
        while i>0:
            if roman[rev[i]]>=roman[rev[i-1]]:
                total+=roman[rev[i]]
            else:
                total-=roman[rev[i]]
            i-=1
        total+=roman[rev[0]]

        return total
