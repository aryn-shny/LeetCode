class Solution:
    def maxArea(self, height: List[int]) -> int:
        highest = 0
        left, right = 0, len(height)-1
        while left < right:
            highest = max(highest,(right-left)*(min(height[right],height[left])))

            if height[left] < height[right]:
                left += 1

            elif height[left] > height[right]:
                right -= 1

            else :
                left += 1
        return highest
